# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# Sphinx output. Sphinx is a build-time generator now (api-src/ -> website/content/api/),
# so this only appears when someone runs sphinx-build by hand to debug the generator.
api-src/_build/

# Env / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/

# Agent scratch space. Worktrees checked out here are whole copies of the repo;
# leaving them untracked-but-unignored is what let one get swept into an sdist.
.claude/worktrees/
.scratch/
