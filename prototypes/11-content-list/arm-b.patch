+def chunk_blocks(
+    blocks: Sequence[Block],
+    *,
+    document_id: str,
+    page: int,
+    size: int,
+    overlap: int,
+    count_tokens: TokenCounter,
+    start_ordinal: int = 0,
+) -> list[Chunk]:
+    """ARM B: chunk a page's typed blocks, carrying each block's type onto its chunks.
+
+    A second entry point beside :func:`chunk_markdown`, because a block-aware
+    chunker cannot reuse the Markdown one: the structural pass splits on headings
+    *across* the whole page, which re-fuses blocks the parser had already
+    separated. So the block path splits per block and loses ``_pack``'s merging
+    of small neighbouring units — the same trade arm (a2) makes, reached by a
+    longer road.
+
+    It also inherits a second source of truth: :func:`_blocks` still sniffs
+    Markdown for tables, so a block declared ``TABLE`` whose markdown does not
+    look like one (and vice versa) now has two disagreeing answers.
+    """
+    chunks: list[Chunk] = []
+    ordinal = start_ordinal
+    for block in blocks:
+        produced = chunk_markdown(
+            block.markdown,
+            document_id=document_id,
+            page=page,
+            size=size,
+            overlap=overlap,
+            count_tokens=count_tokens,
+            start_ordinal=ordinal,
+        )
+        for chunk in produced:
+            chunks.append(
+                Chunk(
+                    id=chunk.id,
+                    document_id=chunk.document_id,
+                    text=chunk.text,
+                    page=chunk.page,
+                    ordinal=chunk.ordinal,
+                    metadata=chunk.metadata,
+                    block_type=block.type,
+                    caption=block.caption,
+                    footnote=block.footnote,
+                )
+            )
+        ordinal += len(produced)
+    return chunks
+
