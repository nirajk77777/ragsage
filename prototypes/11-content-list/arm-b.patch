+def _text_blocks(markdown: str) -> list[Block]:
+    """ARM B: the plain-text path's blocks.
+
+    The heuristic parser has no typed-block model of its own — it produces one
+    Markdown string per page. To fill ``Page.blocks`` at all it must re-derive
+    blocks from that string, i.e. re-run the very heuristic the block type was
+    supposed to replace. Four other format paths (pdf, docx, pptx, html) need the
+    same treatment before ``Page.blocks`` is ever non-empty in production.
+    """
+    from ragsage.parsing.chunking import _blocks
+
+    return [
+        Block(
+            type=BlockType.TABLE if kind == "table" else BlockType.TEXT,
+            markdown=text,
+        )
+        for kind, text in _blocks(markdown)
+    ]
